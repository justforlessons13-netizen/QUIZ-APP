rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Question pack media — anyone can view, only authenticated admins can upload
    match /question-packs/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Printables — anyone can download, only authenticated admins can upload
    match /printables/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
