rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Question packs
    match /questionPacks/{packId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }
    
    // Game Codes
    match /game-codes/{code} {
      allow read, write: if true;
    }
    
    // Active Games
    match /games/{gameId} {
      allow read, write: if true;
    }
    
    // Host Game Sessions
    match /host-sessions/{sessionId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // Spelling Bee word packs
    match /beePacks/{packId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // Spelling Bee host sessions
    match /bee-sessions/{sessionId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // Active Spelling Bee games
    match /bee-games/{gameId} {
      allow read, write: if true;
    }

    // Spelling Bee stage device join codes
    match /bee-game-codes/{code} {
      allow read, write: if true;
    }
  }
}
